# Copy to deploy/.env on the server (never commit the real file).

# Let's Encrypt account email (expiry warnings go here).
ACME_EMAIL=you@example.com

# Public repo the builder clones and builds.
REPO_URL=https://github.com/kandepet/kandepet.com.git
GIT_BRANCH=main

# Shared secret for the GitHub webhook. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
