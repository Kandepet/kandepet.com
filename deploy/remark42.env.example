# Copy to deploy/remark42.env on the server (never commit the real file).
# All options: https://remark42.com/docs/configuration/parameters/

# Signs login tokens. Generate with: openssl rand -hex 32
SECRET=
# Password for the admin API (used by `import`, `backup`, `restore`). openssl rand -hex 16
ADMIN_PASSWD=

# Who can comment. Anonymous = name only, no signup.
AUTH_ANON=true
# Sign in with GitHub (optional): create an OAuth app with callback
# https://comments.kandepet.com/auth/github/callback
AUTH_GITHUB_CID=
AUTH_GITHUB_CSEC=

# Your Remark42 user id (e.g. github_abc123..., shown when you click your name in
# the comment widget after logging in). Makes you a moderator.
ADMIN_SHARED_ID=

# --- Email (optional): sign in by email, reply notifications, new-comment alerts ---
# Leave AUTH_EMAIL_ENABLE=false and NOTIFY_*=none until SMTP is configured.
AUTH_EMAIL_ENABLE=false
AUTH_EMAIL_FROM=comments@kandepet.com
NOTIFY_EMAIL_FROM=comments@kandepet.com
NOTIFY_USERS=none
NOTIFY_ADMINS=none
ADMIN_SHARED_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Cosmetic / limits
EMOJI=true
EDIT_TIME=10m
MAX_COMMENT_SIZE=4000
