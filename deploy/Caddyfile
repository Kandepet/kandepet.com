{
	email {$ACME_EMAIL}
}

# Addresses come from docker-compose.yml (production defaults; overridden by local.env).
{$WWW_ADDRESS} {
	redir {$SITE_URL}{uri} permanent
}

{$SITE_ADDRESS} {
	root * /srv/site/current
	encode zstd gzip

	# Old WordPress URLs (?p=123, /feed/, ...). Generated by migration/wp2hugo.py.
	import /etc/caddy/conf.d/wp-redirects.caddy

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@static path /assets/* /images/* /wp-content/uploads/*
	header @static Cache-Control "public, max-age=604800"

	# GitHub push webhook -> rebuild (the builder verifies the HMAC signature).
	handle /_deploy {
		rewrite * /hooks/deploy
		reverse_proxy builder:9000
	}

	handle {
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

{$COMMENTS_ADDRESS} {
	encode zstd gzip
	reverse_proxy remark42:8080
}
